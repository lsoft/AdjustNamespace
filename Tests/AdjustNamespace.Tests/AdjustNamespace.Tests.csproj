<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The whole code of the extension lives in the shared project AdjustNamespace.VsixShared,
    so this project imports its .projitems instead of referencing an assembly.

    It is a plain SDK style project: it is built and run with `dotnet test`,
    the full MSBuild and the VSSDK targets are NOT required here
    (unlike AdjustNamespace.2022, see ../../CLAUDE.md).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable;CS8766;CS8767</WarningsAsErrors>
    <RootNamespace>AdjustNamespace.Tests</RootNamespace>
    <AssemblyName>AdjustNamespace.Tests</AssemblyName>
    <!-- the shared code is guarded with this symbol, see ../../docs/ARCHITECTURE.md -->
    <DefineConstants>$(DefineConstants);VS2022</DefineConstants>
    <!-- the shared project brings its own file list, so the default globbing is off -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <!-- the conflicting StreamJsonRpc/Microsoft.VisualStudio.* versions are expected and pre-existing -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\AdjustNamespace.VsixShared\AdjustNamespace.VsixShared.projitems" Label="Shared" />

  <ItemGroup>
    <!--
      These files of the shared project depend on the code generated by the VSIX project
      (Vsix, PackageGuids, PackageIds), which does not exist here. They contain no logic
      to test: the package entry point and the menu commands.
    -->
    <Compile Remove="..\..\AdjustNamespace.VsixShared\AdjustNamespacePackage.cs" />
    <Compile Remove="..\..\AdjustNamespace.VsixShared\Command\AdjustNamespaceCommand.cs" />
    <Compile Remove="..\..\AdjustNamespace.VsixShared\Command\AdjustSelectedCommand.cs" />
    <Compile Remove="..\..\AdjustNamespace.VsixShared\Command\AdjustSolutionCommand.cs" />
    <Compile Remove="..\..\AdjustNamespace.VsixShared\Command\EditSkippedPathsCommand.cs" />
    <Compile Remove="..\..\AdjustNamespace.VsixShared\Command\ShowReleaseNotesCommand.cs" />
    <Compile Remove="..\..\AdjustNamespace.VsixShared\InfoBar\ReleaseNotesInfoBarService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**\*.cs;obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- the same versions as in AdjustNamespace.2022 -->
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.486" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.4.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.4.0" />
    <!-- required by AdhocWorkspace to know the C# language; comes from VS itself in the real life -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.4.0" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.4.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39" />

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
