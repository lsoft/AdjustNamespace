<UserControl
    x:Class="AdjustNamespace.UI.Control.ReviewUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:review="clr-namespace:AdjustNamespace.UI.ViewModel.Review"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Margin="0,0,0,2"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                Text="{Binding Summary}"
                TextWrapping="Wrap"
                />
            <TextBlock
                Margin="0,0,0,4"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                Opacity="0.65"
                Text="{Binding ModeText}"
                />
        </StackPanel>

        <WrapPanel
            Grid.Row="1"
            Margin="0,0,0,6"
            >
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                Text="Show:"
                />
            <CheckBox
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Content="Certain"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                IsChecked="{Binding ShowCertain, Mode=TwoWay}"
                />
            <CheckBox
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Content="Likely"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                IsChecked="{Binding ShowLikely, Mode=TwoWay}"
                />
            <CheckBox
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Content="Possible"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                IsChecked="{Binding ShowPossible, Mode=TwoWay}"
                />
            <CheckBox
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Content="Unlikely"
                Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                IsChecked="{Binding ShowUnlikely, Mode=TwoWay}"
                />
            <Button
                Margin="2"
                Padding="10,3,10,3"
                Command="{Binding CheckLikelyCommand}"
                Content="Check all Likely"
                />
            <Button
                Margin="2"
                Padding="10,3,10,3"
                Command="{Binding CheckAllCommand}"
                Content="Check all"
                />
            <Button
                Margin="2"
                Padding="10,3,10,3"
                Command="{Binding UncheckAllCommand}"
                Content="Uncheck all"
                />
        </WrapPanel>

        <TreeView
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            ItemsSource="{Binding Files}"
            >
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="True" />
                    <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick" />
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <HierarchicalDataTemplate
                    DataType="{x:Type review:ReviewFileViewModel}"
                    ItemsSource="{Binding Matches}"
                    >
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                        Text="{Binding DisplayPath}"
                        ToolTip="{Binding FilePath}"
                        />
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type review:ReviewMatchViewModel}">
                    <StackPanel
                        Margin="0,1"
                        Orientation="Horizontal"
                        ToolTip="{Binding ToolTip}"
                        >
                        <CheckBox
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            />
                        <Border
                            Margin="8,0,8,0"
                            Padding="5,0"
                            Background="{Binding LevelBrush}"
                            CornerRadius="3"
                            >
                            <TextBlock
                                FontSize="11"
                                Foreground="White"
                                Text="{Binding LevelText}"
                                />
                        </Border>
                        <TextBlock
                            Width="40"
                            Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                            Opacity="0.65"
                            Text="{Binding Line}"
                            />
                        <TextBlock Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
                            <Run Text="{Binding LineBefore, Mode=OneWay}" /><Run
                                FontWeight="Bold"
                                Text="{Binding LineMatch, Mode=OneWay}"
                                TextDecorations="Underline"
                                /><Run Text="{Binding LineAfter, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock
                            Margin="16,0,0,0"
                            Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                            Opacity="0.65"
                            Text="{Binding Change}"
                            />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <Grid
            Grid.Row="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="80"
                Margin="2"
                Padding="10,5,10,5"
                HorizontalAlignment="Left"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                >
                <Button
                    Width="100"
                    Margin="2"
                    Padding="10,5,10,5"
                    Command="{Binding PreviousCommand}"
                    Content="Previous"
                    />
                <Button
                    Width="80"
                    Margin="2"
                    Padding="10,5,10,5"
                    Command="{Binding NextCommand}"
                    Content="Next"
                    IsDefault="True"
                    />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
